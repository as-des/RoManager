<Window
    x:Class="RoManager.App.AddAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add account">

    <Grid Background="{StaticResource AppBg}" Padding="22,20,22,18">
        <StackPanel VerticalAlignment="Center">
            <!-- Main path: sign in through the browser -->
            <Button x:Name="BrowserButton" Style="{StaticResource AppPrimaryButton}"
                    Height="46" Click="OnBrowser">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE774;" FontSize="15" />
                    <TextBlock x:Name="BrowserText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Divider: browser / manual cookie paste -->
            <Grid Margin="0,14" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="1" Background="#26FFFFFF" VerticalAlignment="Center" />
                <TextBlock x:Name="OrText" Grid.Column="1"
                           Style="{StaticResource AppMutedText}"
                           FontSize="11" CharacterSpacing="100"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2" Height="1" Background="#26FFFFFF" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="10">
                <PasswordBox x:Name="CookieBox" Style="{StaticResource AppPasswordBox}" />

                <Button x:Name="CookieButton" Style="{StaticResource AppSecondaryButton}"
                        Padding="18,11" MinHeight="42" Click="OnCookie" />
            </StackPanel>

            <Button x:Name="CancelButton" Style="{StaticResource AppGhostButton}"
                    Content="Cancel" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12,9,12,9"
                    FontSize="14"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
