<Project>
  <!--
    This machine has no Visual Studio Build Tools, so the
    Microsoft.Build.AppxPackage.* / Microsoft.Build.Packaging.Pri.Tasks.* tasks
    are unavailable. An unpackaged build does not need packaging output groups,
    so they are replaced with simple implementations. PRI is disabled in the csproj.
  -->
  <Target Name="CopyLocalFilesOutputGroup"
          DependsOnTargets="$(CopyLocalFilesOutputGroupDependsOn)"
          Returns="@(CopyLocalFilesOutputGroupOutput)">
    <ItemGroup>
      <CopyLocalFilesOutputGroupOutput Include="@(ReferenceCopyLocalPaths)">
        <TargetPath>%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</TargetPath>
      </CopyLocalFilesOutputGroupOutput>
    </ItemGroup>
  </Target>

  <Target Name="GetPackagingOutputs"
          Returns="@(PackagingOutputs)"
          DependsOnTargets="$(GetPackagingOutputsDependsOn)">
    <ItemGroup>
      <PackagingOutputs Include="@(CopyLocalFilesOutputGroupOutput)" />
    </ItemGroup>
  </Target>

  <!--
    The built-in PRI generation is disabled (AppxGeneratePriEnabled=false), so
    resources.pri is built here: makepri.exe plus merged WinUI resources.
    Without it the app crashes in XamlControlsResources with
    "Cannot locate resource ... themeresources.xaml".
  -->
  <Target Name="GenerateAppPri" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\make-pri.ps1&quot; -OutputDir &quot;$(TargetDir).&quot;"
          ContinueOnError="true" />
  </Target>

  <!--
    Publish copies files from ReferenceCopyLocalPaths, so the generated
    resources.pri does not reach the publish folder; add it explicitly,
    otherwise the portable build crashes on startup.
  -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(TargetDir)resources.pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)resources.pri')" />

    <!-- Compiled XAML (*.xbf) is not copied to publish automatically either. -->
    <ItemGroup>
      <_XbfToPublish Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfToPublish)"
          DestinationFiles="@(_XbfToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Prunes the publish output: ~85 WinUI localisation folders the app never uses
    (the UI ships only ru/en) and *.pdb files, so the archive looks structured
    instead of being a pile of files.
  -->
  <Target Name="PrunePublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\prune-publish.ps1&quot; -Dir &quot;$(PublishDir).&quot;"
          ContinueOnError="true" />
  </Target>
</Project>
