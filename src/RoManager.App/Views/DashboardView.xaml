<UserControl
    x:Class="RoManager.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoManager.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: настройки и выход справа (язык — только в настройках) -->
        <Grid x:Name="DashHeader" Grid.Row="0" Padding="28,16"
              BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="DashboardSettingsButton" Style="{StaticResource AppOverlayButton}"
                        Click="OnOpenSettings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                <Button x:Name="LogoutButton" Style="{StaticResource AppHeaderGhostButton}"
                        Click="OnLogout" />
            </StackPanel>
        </Grid>

        <Grid x:Name="DashBody" Grid.Row="1" Padding="28,24" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColAccounts" Width="*" />
                <ColumnDefinition x:Name="ColSidebar" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowAccounts" Height="*" />
                <RowDefinition x:Name="RowSidebar" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Аккаунты -->
            <controls:GlassSurface x:Name="AccountsPanel" Grid.Row="0" Grid.Column="0" Style="{StaticResource AppGlassPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="AccountsTitle" Style="{StaticResource AppPanelTitle}" />

                    <!-- Шапка таблицы уже строк на ширину скроллбара (calc(100% - 8px)) -->
                    <Grid Grid.Row="1" Margin="0,0,8,0" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="34*" />
                            <ColumnDefinition Width="16*" />
                            <ColumnDefinition Width="25*" />
                            <ColumnDefinition Width="25*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColAccount" Grid.Column="1" Style="{StaticResource AppCaption}"
                                   Margin="0,0,10,12" />
                        <TextBlock x:Name="ColStatus" Grid.Column="2" Style="{StaticResource AppCaption}"
                                   Margin="0,0,10,12" />
                        <TextBlock x:Name="ColLast" Grid.Column="3" Style="{StaticResource AppCaption}"
                                   Margin="0,0,10,12" />
                        <TextBlock x:Name="ColData" Grid.Column="4" Style="{StaticResource AppCaption}"
                                   Margin="0,0,10,12" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="AccountsScroll" Grid.Column="0" VerticalScrollBarVisibility="Hidden"
                                      Padding="0,0,8,0">
                            <StackPanel x:Name="AccountList" />
                        </ScrollViewer>
                        <controls:ThinScrollBar x:Name="AccountsBar" Grid.Column="1" />
                    </Grid>
                </Grid>
            </controls:GlassSurface>

            <!-- Правая колонка -->
            <StackPanel x:Name="Sidebar" Grid.Row="0" Grid.Column="1" Spacing="16">
                <controls:GlassSurface Style="{StaticResource AppGlassPanel}">
                    <StackPanel>
                        <TextBlock x:Name="ActionsTitle" Style="{StaticResource AppPanelTitle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="AddButton" Style="{StaticResource AppPrimaryButton}" Height="44"
                                    Padding="14,0" Click="OnAddAccount">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                                    <TextBlock x:Name="AddText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource AppIconButton}"
                                    Click="OnRefreshAccount">
                                <FontIcon Glyph="&#xE72C;" FontSize="18" />
                            </Button>

                            <Button x:Name="DeleteButton" Grid.Column="2" Style="{StaticResource AppDangerIconButton}"
                                    Click="OnDeleteAccounts">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </controls:GlassSurface>

                <controls:GlassSurface x:Name="ManagePanel" Style="{StaticResource AppGlassPanel}">
                    <StackPanel x:Name="ManageInner">
                        <TextBlock x:Name="ManageTitle" Style="{StaticResource AppPanelTitle}" />

                        <!-- Сегменты как в 2.1.0: неактивные — 44 px с иконкой,
                             активный растягивается и показывает содержимое без иконки. -->
                        <Grid x:Name="ManageRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ManageColGame" Width="*" />
                                <ColumnDefinition x:Name="ManageColPlayer" Width="*" />
                                <ColumnDefinition x:Name="ManageColLauncher" Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="GameSegment" Style="{StaticResource AppManageSegment}" Tapped="OnGameSegmentTapped">
                                <Grid>
                                    <FontIcon x:Name="GameIcon" Glyph="&#xE7FC;" FontSize="18" Foreground="#FF888888"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid x:Name="GameContent" VerticalAlignment="Center" Margin="10,0"
                                          Visibility="Collapsed" Tapped="OnManageContentTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GameInput" Grid.Column="0" Style="{StaticResource AppManageInput}"
                                                 MinWidth="0" Margin="0,0,6,0" KeyDown="OnManageKeyDown" />
                                        <Button x:Name="GameSubmit" Grid.Column="1" Style="{StaticResource AppManageSubmit}"
                                                Click="OnGameSubmit">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="PlayerSegment" Grid.Column="1" Style="{StaticResource AppManageSegment}"
                                    Tapped="OnPlayerSegmentTapped">
                                <Grid>
                                    <FontIcon x:Name="PlayerIcon" Glyph="&#xE77B;" FontSize="18" Foreground="#FF888888"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid x:Name="PlayerContent" VerticalAlignment="Center" Margin="10,0"
                                          Visibility="Collapsed" Tapped="OnManageContentTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PlayerInput" Grid.Column="0" Style="{StaticResource AppManageInput}"
                                                 MinWidth="0" Margin="0,0,6,0" KeyDown="OnManageKeyDown" />
                                        <Button x:Name="PlayerSubmit" Grid.Column="1" Style="{StaticResource AppManageSubmit}"
                                                Click="OnPlayerSubmit">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="LauncherSegment" Grid.Column="2" Style="{StaticResource AppManageSegment}"
                                    Tapped="OnLauncherSegmentTapped">
                                <Grid>
                                    <FontIcon x:Name="LauncherIcon" Glyph="&#xE768;" FontSize="18" Foreground="#FF888888"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel x:Name="LauncherContent" Orientation="Horizontal"
                                                Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed" Tapped="OnManageContentTapped">
                                        <Button x:Name="LauncherPlay" Style="{StaticResource AppManagePlayButton}"
                                                Click="OnLaunch">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        </Button>
                                        <TextBlock x:Name="LauncherLabel" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="#FFCCCCCC" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </controls:GlassSurface>
            </StackPanel>
        </Grid>

        <!-- Модальные окна в стиле 2.1.0 -->
        <Grid x:Name="ModalOverlay" Background="#A6000000" Visibility="Collapsed">
            <controls:GlassSurface x:Name="ModalCard" Style="{StaticResource AppGlassModal}">
                <StackPanel x:Name="ModalBody" />
            </controls:GlassSurface>
        </Grid>
    </Grid>
</UserControl>
