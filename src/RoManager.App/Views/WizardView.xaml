<UserControl
    x:Class="RoManager.App.Views.WizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoManager.App.Controls">

    <!-- Геометрия 2.1.0: карточка 400 px, шапка той же ширины. -->
    <Grid Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <Grid Width="400" Margin="0,0,0,28">
                <Button x:Name="BackButton" Style="{StaticResource AppGhostButton}" VerticalAlignment="Center"
                        Click="OnBack">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock x:Name="BackText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="Dot1" Width="6" Height="6" CornerRadius="3" Background="#FF333333" VerticalAlignment="Center" />
                    <Border x:Name="Dot2" Width="6" Height="6" CornerRadius="3" Background="#FF333333" VerticalAlignment="Center" />
                    <Border x:Name="Dot3" Width="6" Height="6" CornerRadius="3" Background="#FF333333" VerticalAlignment="Center" />
                    <Border x:Name="Dot4" Width="6" Height="6" CornerRadius="3" Background="#FF333333" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <controls:GlassSurface Style="{StaticResource AppGlassCard}" Width="400">
                <StackPanel>
                    <TextBlock x:Name="StepLabel" Style="{StaticResource AppCaption}" Margin="0,0,0,6" />

                    <!-- Шаг 1: ключевой файл -->
                    <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                        <TextBlock x:Name="FileTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />

                        <Grid x:Name="DropZone" Height="150" Margin="0,0,0,14" Background="Transparent"
                              AllowDrop="True" DragOver="OnDropDragOver" DragLeave="OnDropDragLeave"
                              Drop="OnDrop" Tapped="OnDropZoneTapped">
                            <Rectangle x:Name="DropRect" Stroke="#FF333333" StrokeThickness="1.5"
                                       RadiusX="12" RadiusY="12" StrokeDashArray="4 3" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#FF888888" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M21,15 L21,19 A2,2 0 0 1 19,21 L5,21 A2,2 0 0 1 3,19 L3,15" />
                                        <Path Stroke="#FF888888" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M17,8 L12,3 L7,8" />
                                        <Path Stroke="#FF888888" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M12,3 L12,15" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="DropHint" Foreground="#FF888888" FontSize="14" HorizontalAlignment="Center" />
                                <TextBlock x:Name="KeyFileName" Foreground="{StaticResource AppPrimary}" FontSize="13"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ChooseFileButton" Style="{StaticResource AppSecondaryButton}"
                                Margin="0,0,0,10" Click="OnChooseFile" />
                        <Button x:Name="FileNextButton" Style="{StaticResource AppPrimaryButton}" Click="OnFileNext" IsEnabled="False" />
                    </StackPanel>

                    <!-- Шаг 2: фраза -->
                    <StackPanel x:Name="PhrasePanel" Visibility="Collapsed">
                        <TextBlock x:Name="PhraseTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />
                        <TextBlock x:Name="PhraseHint" Style="{StaticResource AppMutedText}" Margin="0,0,0,14" />
                        <TextBox x:Name="PhraseBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,18" />
                        <TextBlock x:Name="PhraseError" Foreground="{StaticResource AppDanger}" FontSize="12.5"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <Button x:Name="PhraseNextButton" Style="{StaticResource AppPrimaryButton}" Click="OnPhraseNext" />
                    </StackPanel>

                    <!-- Шаг 3: PIN -->
                    <StackPanel x:Name="PinPanel" Visibility="Collapsed">
                        <TextBlock x:Name="PinTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />
                        <controls:PinDots x:Name="AccessPinDots" />
                        <TextBlock x:Name="PinHint" Style="{StaticResource AppMutedText}" Margin="0,0,0,14" />
                        <PasswordBox x:Name="PinBox" Style="{StaticResource AppPasswordBox}" MaxLength="6"
                                     Margin="0,0,0,18" PasswordChanged="OnPinChanged" />
                        <TextBlock x:Name="PinError" Foreground="{StaticResource AppDanger}" FontSize="12.5"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <Button x:Name="PinNextButton" Style="{StaticResource AppPrimaryButton}" Click="OnPinNext" />
                    </StackPanel>

                    <!-- Шаг 4: подтверждение входа -->
                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                        <TextBlock x:Name="ConfirmTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />
                        <Border Background="#FF0F0F0F" CornerRadius="10" BorderBrush="#FF222222"
                                BorderThickness="1" Margin="0,0,0,22">
                            <StackPanel>
                                <Grid Padding="16,12">
                                    <TextBlock x:Name="SummaryFileLabel" Foreground="{StaticResource AppMuted}" FontSize="14" />
                                    <TextBlock x:Name="SummaryFileValue" Foreground="#FFDDDDDD" FontSize="14"
                                               FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="#FF1A1A1A" />
                                <Grid Padding="16,12">
                                    <TextBlock x:Name="SummaryPhraseLabel" Foreground="{StaticResource AppMuted}" FontSize="14" />
                                    <TextBlock x:Name="SummaryPhraseValue" Foreground="#FFDDDDDD" FontSize="14"
                                               FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="#FF1A1A1A" />
                                <Grid Padding="16,12">
                                    <TextBlock Text="PIN" Foreground="{StaticResource AppMuted}" FontSize="14" />
                                    <TextBlock x:Name="SummaryPinValue" Foreground="#FFDDDDDD" FontSize="14"
                                               FontWeight="Medium" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ConfirmError" Foreground="{StaticResource AppDanger}" FontSize="12.5"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource AppPrimaryButton}" Click="OnConfirmAccess" />
                    </StackPanel>

                    <!-- Создание: фраза -->
                    <StackPanel x:Name="CreatePhrasePanel" Visibility="Collapsed">
                        <TextBlock x:Name="CreatePhraseTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />
                        <TextBlock x:Name="CreatePhraseHint" Style="{StaticResource AppMutedText}" Margin="0,0,0,14" />
                        <TextBox x:Name="CreatePhraseBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,18" />
                        <TextBlock x:Name="CreatePhraseError" Foreground="{StaticResource AppDanger}" FontSize="12.5"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <Button x:Name="CreatePhraseNextButton" Style="{StaticResource AppPrimaryButton}" Click="OnCreatePhraseNext" />
                    </StackPanel>

                    <!-- Создание: PIN -->
                    <StackPanel x:Name="CreatePinPanel" Visibility="Collapsed">
                        <TextBlock x:Name="CreatePinTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />
                        <controls:PinDots x:Name="CreatePinDots" />
                        <TextBlock x:Name="CreatePinHint" Style="{StaticResource AppMutedText}" Margin="0,0,0,14" />
                        <PasswordBox x:Name="CreatePinBox" Style="{StaticResource AppPasswordBox}" MaxLength="6"
                                     Margin="0,0,0,18" PasswordChanged="OnCreatePinChanged" />
                        <TextBlock x:Name="CreatePinError" Foreground="{StaticResource AppDanger}" FontSize="12.5"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <Button x:Name="CreatePinNextButton" Style="{StaticResource AppPrimaryButton}" Click="OnCreatePinNext" />
                    </StackPanel>

                    <!-- Создание: подтверждение PIN -->
                    <StackPanel x:Name="CreateConfirmPanel" Visibility="Collapsed">
                        <TextBlock x:Name="CreateConfirmTitle" Style="{StaticResource AppH2}" Margin="0,0,0,18" />
                        <controls:PinDots x:Name="CreateConfirmDots" />
                        <TextBlock x:Name="CreateConfirmHint" Style="{StaticResource AppMutedText}" Margin="0,0,0,14" />
                        <PasswordBox x:Name="CreateConfirmBox" Style="{StaticResource AppPasswordBox}" MaxLength="6"
                                     Margin="0,0,0,18" PasswordChanged="OnCreateConfirmChanged" />
                        <TextBlock x:Name="CreateConfirmError" Foreground="{StaticResource AppDanger}" FontSize="12.5"
                                   Margin="0,0,0,12" Visibility="Collapsed" />
                        <Button x:Name="CreateConfirmButton" Style="{StaticResource AppPrimaryButton}" Click="OnCreateConfirm" />
                    </StackPanel>

                    <!-- Готово -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#1FF59E0B"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <FontIcon Glyph="&#xE8D7;" FontSize="26" Foreground="#FFF59E0B" />
                        </Border>
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource AppH2}" HorizontalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBlock x:Name="DoneLine1" Style="{StaticResource AppMutedText}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,0,0,2" />
                        <TextBlock x:Name="DoneLine2" Style="{StaticResource AppMutedText}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,0,0,22" />
                        <Button x:Name="DownloadKeyButton" Style="{StaticResource AppPrimaryButton}" Margin="0,0,0,10"
                                Click="OnDownloadKey" />
                        <Button x:Name="ToMainButton" Style="{StaticResource AppSecondaryButton}" Click="OnToMain" />
                    </StackPanel>
                </StackPanel>
            </controls:GlassSurface>
        </StackPanel>
    </Grid>
</UserControl>

