<UserControl
    x:Class="RoManager.App.Views.LandingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Как в 2.1.0: только две кнопки по центру, без заголовков и подсказок. -->
    <Grid Padding="24">
        <StackPanel MaxWidth="400" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,40,0,0" Spacing="10">
            <Button x:Name="HaveAccessButton" Style="{StaticResource AppPrimaryButton}" Click="OnHaveAccess" />
            <Button x:Name="NoAccessButton" Style="{StaticResource AppSecondaryButton}" Click="OnNoAccess" />
        </StackPanel>
    </Grid>
</UserControl>
