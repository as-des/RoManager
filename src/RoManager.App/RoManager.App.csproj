<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RoManager.App</RootNamespace>
    <AssemblyName>RoManager</AssemblyName>
    <Version>0.03</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <!-- This machine has no Visual Studio Build Tools, so the PRI tasks
         (Microsoft.Build.Packaging.Pri.Tasks) are unavailable. resources.pri
         is built separately by tools/make-pri.ps1
         (see Directory.Build.targets -> GenerateAppPri). -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <!-- The app is localised only into Russian and English. Without this,
         publish emits ~85 pointless WinUI/WindowsAppSDK localisation folders. -->
    <SatelliteResourceLanguages>ru;en;en-us</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoManager.Core\RoManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />    <Page Include="Theme.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="SettingsWindow.xaml" />
    <Page Include="AddAccountWindow.xaml" />
    <Page Include="BrowserLoginWindow.xaml" />
    <Page Include="DeleteAccountWindow.xaml" />
    <Page Include="Views\LandingView.xaml" />
    <Page Include="Views\WizardView.xaml" />
    <Page Include="Views\DashboardView.xaml" />
  </ItemGroup>

  <!-- Window icon: WinUI does not take it from assembly resources, so the file must sit next to the exe. -->
  <ItemGroup>
    <Content Include="..\..\app.ico" Link="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Brand font Unbounded (OFL). The file must sit next to the exe:
       FontFamily references it as ms-appx:///Assets/Fonts/... -->
  <ItemGroup>
    <Content Include="Assets\Fonts\Unbounded.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
