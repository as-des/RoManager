<Window
    x:Class="RoManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RoManager">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- РЁР°РїРєР° РѕРєРЅР° -->
        <Grid Grid.Row="0" Background="#FF0F1115" Padding="14,0" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AppPrimary}">
                    <TextBlock Text="R" FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource AppHeaderTitle}" Text="RoManager" />
                <Border Background="#FF1C1C20" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderVersion" Style="{StaticResource AppCaption}" Text="3.0" />
                </Border>
            </StackPanel>

            <Button x:Name="HeaderSettings"
                    Style="{StaticResource AppGhostButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnOpenSettings">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock x:Name="HeaderSettingsText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Р­РєСЂР°РЅС‹: landing в†’ РјР°СЃС‚РµСЂ в†’ dashboard -->
        <ContentControl x:Name="ContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <!-- РЎС‚СЂРѕРєР° СЃРѕСЃС‚РѕСЏРЅРёСЏ -->
        <Grid Grid.Row="2" Background="#FF0F1115" Padding="14,0" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource AppMuted}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource AppMutedText}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusRight" Style="{StaticResource AppCaption}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Text="WinUI 3" />
        </Grid>
    </Grid>
</Window>
