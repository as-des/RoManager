<Window
    x:Class="RoManager.App.DeleteAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete accounts">

    <Grid Background="{StaticResource AppBg}" Padding="22,20,22,18">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="HeadingText"
                       Foreground="{StaticResource AppText}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="BodyText"
                       Style="{StaticResource AppMutedText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <Button x:Name="DeleteButton" Style="{StaticResource AppDangerButton}"
                    MinHeight="42" Click="OnDelete" />

            <Button x:Name="CancelButton" Style="{StaticResource AppSecondaryButton}"
                    Margin="0,10,0,0" MinHeight="42" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
