<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- РџР°Р»РёС‚СЂР° РІР·СЏС‚Р° РёР· legacy frontend/src/styles/app.css -->
    <SolidColorBrush x:Key="AppBg" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="AppCard" Color="#FF141414" />
    <SolidColorBrush x:Key="AppBorder" Color="#FF242424" />
    <SolidColorBrush x:Key="AppText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppMuted" Color="#FF8A8A94" />
    <SolidColorBrush x:Key="AppPrimary" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="AppPrimaryHover" Color="#FF2563EB" />
    <SolidColorBrush x:Key="AppSuccess" Color="#FF22C55E" />
    <SolidColorBrush x:Key="AppWarning" Color="#FFEAB308" />
    <SolidColorBrush x:Key="AppDanger" Color="#FFEF4444" />

    <!-- Акцентные цвета: переопределяем системный акцент, чтобы тумблеры,
         прогресс и выделение совпадали с палитрой legacy-версии. -->
    <Color x:Key="SystemAccentColor">#FF3B82F6</Color>
    <Color x:Key="SystemAccentColorLight1">#FF60A5FA</Color>
    <Color x:Key="SystemAccentColorLight2">#FF93C5FD</Color>
    <Color x:Key="SystemAccentColorLight3">#FFBFDBFE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF2563EB</Color>
    <Color x:Key="SystemAccentColorDark2">#FF1D4ED8</Color>
    <Color x:Key="SystemAccentColorDark3">#FF1E40AF</Color>

    <x:Double x:Key="AppRadius">14</x:Double>

    <Style x:Key="AppH1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppH2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <!-- РљР°СЂС‚РѕС‡РєР°: С‚РѕРЅРєР°СЏ СЂР°РјРєР°, СЃРєСЂСѓРіР»РµРЅРёРµ РєР°Рє РІ РІРµР±-РІРµСЂСЃРёРё -->
    <Style x:Key="AppCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="AppPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#FF1C1C20" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Р—Р°РіРѕР»РѕРІРѕРє СЃРµРєС†РёРё РІ РЅР°СЃС‚СЂРѕР№РєР°С… -->
    <Style x:Key="AppSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <!-- РЎС‚СЂРѕРєР° РЅР°СЃС‚СЂРѕР№РєРё: Р·Р°РіРѕР»РѕРІРѕРє + РѕРїРёСЃР°РЅРёРµ -->
    <Style x:Key="AppRowTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppRowHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FF101014" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="AppPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#FF101014" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="AppNumberBox" TargetType="NumberBox">
        <Setter Property="SpinButtonPlacementMode" Value="Compact" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!-- РЁР°РїРєР° РѕРєРЅР°: РёРјСЏ РїСЂРёР»РѕР¶РµРЅРёСЏ Рё РєРЅРѕРїРєР° РЅР°СЃС‚СЂРѕРµРє -->
    <Style x:Key="AppHeaderTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
