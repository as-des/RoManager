<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RoManager.App.Controls">

    <!-- Design tokens ported from frontend/src/styles/app.css (2.1.0). -->
    <SolidColorBrush x:Key="AppBg" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="AppCard" Color="#8C12141C" />
    <SolidColorBrush x:Key="AppCardSolid" Color="#FF141414" />
    <SolidColorBrush x:Key="AppBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppBorderStrong" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppDivider" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="AppText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppMuted" Color="#FF888888" />
    <SolidColorBrush x:Key="AppMuted2" Color="#FF666666" />
    <SolidColorBrush x:Key="AppPrimary" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="AppPrimaryHover" Color="#FF2563EB" />
    <SolidColorBrush x:Key="AppPrimaryPressed" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="AppPrimaryDisabled" Color="#FF1E3A5F" />
    <SolidColorBrush x:Key="AppPrimaryDisabledText" Color="#FF5A7AA5" />
    <!-- Glow around active elements: the same accent with transparency. -->
    <SolidColorBrush x:Key="AppPrimaryGlow" Color="#263B82F6" />
    <SolidColorBrush x:Key="AppSuccess" Color="#FF22C55E" />
    <SolidColorBrush x:Key="AppWarning" Color="#FFEAB308" />
    <SolidColorBrush x:Key="AppDanger" Color="#FFEF4444" />
    <SolidColorBrush x:Key="AppInputBg" Color="#FF0F0F0F" />
    <SolidColorBrush x:Key="AppInputBorder" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="AppSecondaryBg" Color="#8C1A1C24" />
    <SolidColorBrush x:Key="AppSecondaryHover" Color="#B3282B34" />
    <SolidColorBrush x:Key="AppStatusBar" Color="#D90A0C12" />
    <SolidColorBrush x:Key="AppWinBg" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="AppWhiteA12" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppWhiteA4" Color="#0AFFFFFF" />

    <!-- Scrollbars as in 2.1.0: a thin dark #3a3a3a thumb with no track -->
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FF3A3A3A" />

    <!-- Accent: matches the legacy primary -->
    <Color x:Key="SystemAccentColor">#FF3B82F6</Color>
    <Color x:Key="SystemAccentColorLight1">#FF60A5FA</Color>
    <Color x:Key="SystemAccentColorLight2">#FF93C5FD</Color>
    <Color x:Key="SystemAccentColorLight3">#FFBFDBFE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF2563EB</Color>
    <Color x:Key="SystemAccentColorDark2">#FF1D4ED8</Color>
    <Color x:Key="SystemAccentColorDark3">#FF1E40AF</Color>

    <x:Double x:Key="AppRadius">14</x:Double>
    <x:Double x:Key="AppRadiusSm">10</x:Double>

    <!-- Brand font: Unbounded (OFL, shipped in Assets/Fonts). Headings, buttons
         and tabs use it; table text and captions stay on the system font,
         otherwise the wide letters break the columns. -->
    <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/Unbounded.ttf#Unbounded</FontFamily>

    <!-- ========== Text ========== -->
    <Style x:Key="AppH1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppH2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppBody" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted2}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="AppPanelTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFCCCCCC" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="AppSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF999999" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="AppRowTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFC2C8D4" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppRowHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF999999" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ========== Containers ========== -->
    <Style x:Key="AppCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="28,28,24,28" />
    </Style>

    <Style x:Key="AppPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- ========== Glass surfaces (backdrop blur) ========== -->
    <Style x:Key="AppGlassBase" TargetType="controls:GlassSurface">
        <Setter Property="Background" Value="{StaticResource AppCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassSurface">
                    <Grid>
                        <!-- Tint and border over the window's blurred background.
                             There is no separate backdrop layer: that layer produced
                             the doubled panels on click and resize. -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppGlassPanel" TargetType="controls:GlassSurface" BasedOn="{StaticResource AppGlassBase}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="AppGlassCard" TargetType="controls:GlassSurface" BasedOn="{StaticResource AppGlassBase}">
        <Setter Property="Padding" Value="28,28,24,28" />
    </Style>

    <Style x:Key="AppGlassModal" TargetType="controls:GlassSurface" BasedOn="{StaticResource AppGlassBase}">
        <Setter Property="Background" Value="#B810121A" />
        <Setter Property="Padding" Value="28,24" />
        <Setter Property="Width" Value="380" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status bar: a dark strip over the blurred background -->
    <Style x:Key="AppGlassStatus" TargetType="controls:GlassSurface" BasedOn="{StaticResource AppGlassBase}">
        <Setter Property="Background" Value="{StaticResource AppStatusBar}" />
        <Setter Property="BorderBrush" Value="#24FFFFFF" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="28,0" />
    </Style>

    <!-- Notification card over the blurred background -->
    <Style x:Key="AppGlassNotice" TargetType="controls:GlassSurface" BasedOn="{StaticResource AppGlassBase}">
        <Setter Property="Background" Value="#D91E222D" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ========== Buttons ========== -->
    <Style x:Key="AppPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AppPrimaryHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AppPrimaryPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AppPrimaryDisabled}" />
                                        <Setter Target="Content.Foreground" Value="{StaticResource AppPrimaryDisabledText}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppSecondaryBg}" />
        <Setter Property="Foreground" Value="#FFCCCCCC" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AppSecondaryHover}" />
                                        <Setter Target="Root.BorderBrush" Value="#2EFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#CC1A1C24" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDangerButton" TargetType="Button">
        <Setter Property="Background" Value="#FF1A1A1A" />
        <Setter Property="Foreground" Value="#FFF87171" />
        <Setter Property="BorderBrush" Value="#FF3A2020" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF2A1515" />
                                        <Setter Target="Root.BorderBrush" Value="#FF5A3030" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF2A1515" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button (44x44) -->
    <Style x:Key="AppIconButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppDangerIconButton" TargetType="Button" BasedOn="{StaticResource AppDangerButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Top-right button (gear) -->
    <Style x:Key="AppOverlayButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource AppWhiteA4}" />
        <Setter Property="Foreground" Value="#FF9AA2B1" />
        <Setter Property="BorderBrush" Value="{StaticResource AppWhiteA12}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#1AFFFFFF" />
                                        <Setter Target="Root.BorderBrush" Value="#33FFFFFF" />
                                        <Setter Target="Content.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#1AFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour swatch button: opens the ColorPicker palette -->
    <Style x:Key="AppColorSwatchButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="7">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#1FFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#2EFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppLangButton" TargetType="Button">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF8A92A2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sign-out button in the dashboard header -->
    <Style x:Key="AppHeaderGhostButton" TargetType="Button" BasedOn="{StaticResource AppSecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#FF2A2A2A" />
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Account controls: drawers from do.html in the app palette -->
    <Style x:Key="AppManageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Margin" Value="4,0,0,10" />
    </Style>

    <Style x:Key="AppManageSegment" TargetType="Border">
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="{StaticResource AppSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppWhiteA12}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AppManageInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppText}" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource AppMuted2}" />
