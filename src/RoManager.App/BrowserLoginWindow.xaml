<Window
    x:Class="RoManager.App.BrowserLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Roblox sign-in">

    <Grid Background="{StaticResource AppBg}">
        <WebView2 x:Name="Browser" Loaded="OnBrowserLoaded" />

        <Grid x:Name="LoadingOverlay" Background="{StaticResource AppBg}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing IsActive="True" Width="34" Height="34"
                              Foreground="{StaticResource AppPrimary}" />
                <TextBlock x:Name="LoadingText" Style="{StaticResource AppMutedText}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
