<Window
    x:Class="RoManager.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView x:Name="Tabs" Grid.Row="0" Margin="10,6,10,0"
                 TabWidthMode="Equal" CanReorderTabs="False" IsAddTabButtonVisible="False">
            <TabViewItem x:Name="GeneralTab" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="2,6,10,18" Spacing="2" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="InterfaceTitle" Style="{StaticResource AppSectionTitle}" Margin="0,4,0,8" />
                        <Grid>
                            <TextBlock x:Name="LanguageLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Right" MinWidth="150"
                                      SelectionChanged="OnLanguageChanged" />
                        </Grid>

                        <Border x:Name="LockBanner" Background="#FF1A1A10" BorderBrush="#FF3A3418"
                                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{StaticResource AppWarning}" />
                                <TextBlock x:Name="LockBannerText" Style="{StaticResource AppMutedText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SessionTitle" Style="{StaticResource AppSectionTitle}" />
                        <ContentControl x:Name="SessionSection" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="AutoCookieLabel" Style="{StaticResource AppRowTitle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCookieToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="RefreshLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <NumberBox x:Name="RefreshBox" Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact"
                                           HorizontalAlignment="Right" MinWidth="130" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="DelayLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <NumberBox x:Name="DelayBox" Minimum="0" Maximum="60000" SmallChange="250" LargeChange="1000"
                                           SpinButtonPlacementMode="Compact" HorizontalAlignment="Right" MinWidth="130" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="ClosePrevLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ClosePrevToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel></ContentControl>

                        <TextBlock x:Name="MultiTitle" Style="{StaticResource AppSectionTitle}" />
                        <ContentControl x:Name="MultiSection" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8">
                            <Grid>
                                <TextBlock x:Name="MultiLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="MultiToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                            <TextBlock x:Name="MultiHint" Style="{StaticResource AppRowHint}" />
                        </StackPanel></ContentControl>

                        <TextBlock x:Name="PresenceTitle" Style="{StaticResource AppSectionTitle}" />
                        <ContentControl x:Name="PresenceSection" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14">
                            <Grid>
                                <TextBlock x:Name="ShowPresenceLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PresenceToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="PresenceRateLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <NumberBox x:Name="PresenceRateBox" Minimum="10" Maximum="600" SmallChange="5"
                                           SpinButtonPlacementMode="Compact" HorizontalAlignment="Right" MinWidth="130" />
                            </Grid>
                        </StackPanel></ContentControl>

                        <TextBlock x:Name="FpsTitle" Style="{StaticResource AppSectionTitle}" />
                        <ContentControl x:Name="FpsSection" HorizontalContentAlignment="Stretch"><StackPanel Spacing="14">
                            <Grid>
                                <TextBlock x:Name="UnlockFpsLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="UnlockFpsToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="MaxFpsLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center" />
                                <NumberBox x:Name="MaxFpsBox" Minimum="30" Maximum="1000" SmallChange="10"
                                           SpinButtonPlacementMode="Compact" HorizontalAlignment="Right" MinWidth="130" />
                            </Grid>
                        </StackPanel></ContentControl>

                        <TextBlock x:Name="BrowserTitle" Style="{StaticResource AppSectionTitle}" />
                        <ContentControl x:Name="BrowserSection" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8">
                            <Grid>
                                <TextBlock x:Name="BundledLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,16,0" />
                                <ToggleSwitch x:Name="BundledToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" />
                            </Grid>
                            <TextBlock x:Name="BundledHint" Style="{StaticResource AppRowHint}" />
                        </StackPanel></ContentControl>

                        <TextBlock x:Name="AppliedHint" Style="{StaticResource AppRowHint}" Margin="0,20,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="DeveloperTab" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="2,6,10,18" Spacing="8" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="DebugTitle" Style="{StaticResource AppSectionTitle}" Margin="0,4,0,8" />
                        <Grid>
                            <TextBlock x:Name="DevLogLabel" Style="{StaticResource AppRowTitle}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,16,0" />
                            <ToggleSwitch x:Name="DevLogToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" />
                        </Grid>
                        <TextBlock x:Name="DevLogHint" Style="{StaticResource AppRowHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem x:Name="MiscTab" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="2,6,10,18" Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="AboutTitle" Style="{StaticResource AppSectionTitle}" Margin="0,4,0,8" />
                        <Grid>
                            <TextBlock x:Name="VersionLabel" Style="{StaticResource AppMutedText}" />
                            <TextBlock x:Name="VersionValue" Style="{StaticResource AppBody}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DataFolderLabel" Style="{StaticResource AppMutedText}" />
                            <TextBlock x:Name="DataFolderValue" Style="{StaticResource AppRowHint}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="1" Padding="16,10" Background="#FF0F1115"
              BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="SaveStatus" Style="{StaticResource AppMutedText}" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Style="{StaticResource AppPrimaryButton}" HorizontalAlignment="Right"
                    Padding="18,8" MinHeight="34" MinWidth="170" HorizontalContentAlignment="Center"
                    Click="OnSave" />
        </Grid>
    </Grid>
</Window>
