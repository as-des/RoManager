<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoManager.Core</RootNamespace>
    <AssemblyName>RoManager.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The UI layer needs internal core types (Crypto, Vault, Roblox, Jsons):
         they are non-public on purpose to keep the external contract small. -->
    <InternalsVisibleTo Include="RoManager" />
    <InternalsVisibleTo Include="RoManager.Core.Tests" />
  </ItemGroup>
</Project>
